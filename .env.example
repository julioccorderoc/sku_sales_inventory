# Copy to .env and fill in.  cp .env.example .env
# Never commit .env — it holds the client secret and the Teams webhook URL.

# --- Flexport API (not used yet — the Flexport lane reads CSVs) ---
FLEXPORT_API_KEY=""
FLEXPORT_CODE=""
FLEXPORT_ACCESS_TOKEN=""
FLEXPORT_ACCOUNT_ID=""
BASE_URL="https://logistics-api.flexport.com"

# --- Paths ---
INPUT_DIR="input"
OUTPUT_DIR="output"
COMBINED_FILENAME="inventory_report"
SAVE_JSON_OUTPUT="true"

# --- Microsoft Graph ---
# The app registration shared with the supply_chain_agent
# (`jules-outlook-access-julio-mail`). Ask its owner for these values.
#   MS_CLIENT_SECRET  app-only grant  -> the Excel workbooks (never expires)
#   MS_REFRESH_TOKEN  delegated grant -> the Teams chat lane only (90-day cap)
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_REFRESH_TOKEN=""
MS_REFRESH_TOKEN_ISSUED_AT=""
MS_MAILBOX_ADDRESS="julio@naturalcurelabs.com"

# Workbook driveItem ids (same values the retired n8n workflow used).
MS_INVENTORY_WORKBOOK_ID="016XA7EZ36EKRNDCJNUZA3JXJTLH4YB44K"
MS_HISTORY_WORKBOOK_ID="016XA7EZ74NOVOHL26LZGIUGKTW25ZWYLA"

# --- Publishing ---
PUBLISH_ENABLED="true"

# Teams delivery: webhook | graph_chat | file | none
#   file  — writes output/*.html and posts nothing (safe default)
#   webhook — POSTs to a Power Automate Workflows URL (see docs/teams_reporting.md)
TEAMS_TRANSPORT="file"
TEAMS_WEBHOOK_URL=""

# Which field the Power Automate action binds. The Supply Chain flow posts an
# Adaptive Card, so the body must be the full card envelope — a plain
# {"message": ...} returns HTTP 202 and posts nothing.
TEAMS_WEBHOOK_PAYLOAD="adaptive_card"
TEAMS_CHAT_ID=""
PUBLISH_SEND_GAP_SECONDS="2"

# --- Legacy n8n webhook — superseded by the publisher, leave false ---
WEBHOOK_URL=""
WEBHOOK_ENABLED="false"
